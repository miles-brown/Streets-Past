# Supabase Configuration (required)
# Copy to .env or .env.local. Keys: Dashboard → Settings → API → Project API keys (anon public).
# https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Optional: canonical site URL for SEO (OG previews, JSON-LD, sitemap alignment). Defaults to window.location.origin in dev.
# VITE_SITE_ORIGIN=https://streetetymology.co.uk

# Optional (repo root only): Postgres database password for Supabase CLI migrations from the repo root:
#   ./scripts/db-push.sh
# Put SUPABASE_DB_PASSWORD in the repo root `.env.local` (gitignored), not in committed files.
# Dashboard → Project Settings → Database → Database password
